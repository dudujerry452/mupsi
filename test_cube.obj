# Simple cube (8 vertices, 12 triangles)
v -50 -50 -350
v  50 -50 -350
v  50  50 -350
v -50  50 -350
v -50 -50 -450
v  50 -50 -450
v  50  50 -450
v -50  50 -450
# Front face (z=-350)
f 1 2 3
f 1 3 4
# Back face (z=-450)
f 6 5 8
f 6 8 7
# Right face (x=50)
f 2 6 7
f 2 7 3
# Left face (x=-50)
f 5 1 4
f 5 4 8
# Top face (y=50)
f 4 3 7
f 4 7 8
# Bottom face (y=-50)
f 5 2 1
f 5 6 2
